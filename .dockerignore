# Build context only. What lands in the runtime image is decided by the
# Dockerfile's explicit COPY lines; this file keeps the context small and makes
# sure nothing unwanted is even available to copy.

.git
.github
.agent-office
.astro
dist
node_modules
data
data-staging

# Not needed to build or run the site.
docs
tests
*.md
!README.md
*.log
.env
.env.*
.env.example

# Footage. 52 GB of source clips, renders and posters; the site needs none of
# it. Without this line every `docker compose up --build` hands the whole lot to
# the daemon before the first instruction runs.
videos

# Editor and OS noise
.DS_Store
.idea
.vscode
