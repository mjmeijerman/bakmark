# build output
dist/
# generated types
.astro/

# dependencies
node_modules/

# newsletter list (SQLite, lives on the server)
data/
data-staging/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables: env.dist is the committed template, .env is local
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# render check output; the baseline png is committed
tests/snapshots/confirmation.nl.html
tests/snapshots/confirmation.nl.png

# Footage and Shotcut projects live outside the repo entirely (~/bakmark-footage, see
# docs/shotcut-manual.md). These entries are belt and braces for the case where
# someone drops a render back in here: raw footage is far too large for git.
videos/
bakmark-footage/

# media files anywhere in the repo (belt and braces, in case footage moves)
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.wav
*.mp3
*.m4a
*.aac
*.flac

# editor temp/autosave
*.mlt.autosave
*~
