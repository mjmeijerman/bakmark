# Secrets and paths for the visit counter.
#
# Not committed: copy this file to /var/lib/bakmark-analytics/env on the VPS and
# fill it there. The app's own environment never reads it, and this stack never
# reads the app's.
#
#   sudo install -d -o 1000 -g 1000 -m 700 /var/lib/bakmark-analytics
#   sudo install -d -o 70 -g 70 -m 700 /var/lib/bakmark-analytics/data
#   cp analytics/env.dist /var/lib/bakmark-analytics/env
#   openssl rand -hex 24        # for APP_SECRET
#
#   docker compose --env-file /var/lib/bakmark-analytics/env -f analytics/compose.yaml up -d

# Where Postgres keeps its cluster. Owned by uid 70, the postgres user.
BAKMARK_ANALYTICS_DATA=/var/lib/bakmark-analytics/data

# Signs the dashboard session cookie. Visitors never see it, and nothing else
# uses it. One value, generated once.
APP_SECRET=

# The connection string the Umami image reads, as Postgres and Prisma write it:
# scheme "postgres" + "ql", then user "umami", host "db", port 5432, database
# "umami", and no password because the database trusts this private network.
# Written out here rather than committed in compose.yaml: a connection string
# belongs in one place, and that place is not a repository.
DATABASE_URL=

# Loopback only; Caddy on the host proxies to it.
UMAMI_PORT=8091
