# What the visit counter's env file contains, and why.
#
# Nothing here is filled in by hand: `deploy.sh` writes this file into the
# checkout on the first deploy, with mode 0600, and never touches it again. It
# lives beside the app's own env file rather than in the data directory, because
# that directory belongs to the container's uid and a deploy cannot write into
# it. Git ignores it, and `git reset --hard` leaves it alone.
#
# This file stays in the repository as the record: five values, what each is for,
# and nothing secret. Copy it only if you ever need to rebuild the stack from
# scratch, and delete the old data directory with it.

# Where Postgres keeps its cluster. Provisioning creates this directory owned by
# uid 70, the postgres user inside the image.
BAKMARK_ANALYTICS_DATA=/var/lib/bakmark-analytics/data

# Signs the dashboard session cookie. Visitors never see it, and nothing else
# uses it. Generated once with openssl rand -hex 24.
APP_SECRET=

# The connection string the Umami image reads, as Postgres and Prisma write it:
# scheme "postgres" + "ql", user "umami", host "db", port 5432, database
# "umami", and no password — the database trusts the private compose network
# and publishes no port. Written by the deploy, never by a person, so that a
# connection string lives in one place and not in a repository.
DATABASE_URL=

# Loopback only; the nginx vhost on the host proxies to it.
UMAMI_PORT=8091
