---
import { DIFFICULTY_SCALE, difficultyWord } from "../lib/recipes";

interface Props {
	level: number;
	/** Show the word next to the icon. Off for tight spots. */
	showWord?: boolean;
}

const { level, showWord = true } = Astro.props;
const word = difficultyWord(level);
---

<span class="difficulty-badge" title={`Moeilijkheid ${level} van ${DIFFICULTY_SCALE}: ${word}`}>
	<svg class="difficulty-icon" viewBox="16 16 68 70" focusable="false" aria-hidden="true">
		<path
			d="M 50,20 C 38,20 32,32 38,42 C 28,42 22,55 35,68 L 35,76 C 35,79 38,82 42,82 L 58,82 C 62,82 65,79 65,76 L 65,68 C 78,55 72,42 62,42 C 68,32 62,20 50,20 Z"
			fill="none"
			stroke="currentColor"
			stroke-width="4.5"
			stroke-linecap="round"
			stroke-linejoin="round"></path>
		<path d="M 35,68 L 65,68" fill="none" stroke="currentColor" stroke-width="4.5"></path>
		<path d="M 42,42 C 42,60 42,60 45,68" fill="none" stroke="currentColor" stroke-width="3"></path>
		<path d="M 58,42 C 58,60 58,60 55,68" fill="none" stroke="currentColor" stroke-width="3"></path>
		<path d="M 50,22 C 50,45 50,45 50,68" fill="none" stroke="currentColor" stroke-width="3"></path>
	</svg>
	<span class="difficulty-words">
		<span aria-hidden="true">{showWord ? word : `${level}/${DIFFICULTY_SCALE}`}</span>
		<span class="sr-only">moeilijkheid {level} van {DIFFICULTY_SCALE}, {word}</span>
	</span>
</span>
