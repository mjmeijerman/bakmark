---
import { DIFFICULTY_SCALE, difficultyWord } from "../lib/recipes";

interface Props {
	level: number;
	/** Show the word next to the icon. Off for tight spots. */
	showWord?: boolean;
}

const { level, showWord = true } = Astro.props;
const word = difficultyWord(level);
---

<span class="difficulty-badge" title={`Moeilijkheid ${level} van ${DIFFICULTY_SCALE}: ${word}`}>
	<svg class="difficulty-icon" viewBox="0 0 24 24" focusable="false" aria-hidden="true">
		<rect x="10.8" y="1.4" width="2.4" height="5.4" rx="1.2" fill="currentColor"></rect>
		<path
			d="M12 6.4c-3.5 0-6.3 3.9-6.3 8.4 0 4.6 2.8 7.7 6.3 7.7s6.3-3.1 6.3-7.7c0-4.5-2.8-8.4-6.3-8.4Z"
			fill="none"
			stroke="currentColor"
			stroke-width="1.7"></path>
		<path d="M12 7.6v14.2" fill="none" stroke="currentColor" stroke-width="1.7"></path>
		<path
			d="M8.7 10.6c.9 1.5 1.4 3.6 1.4 5.6M15.3 10.6c-.9 1.5-1.4 3.6-1.4 5.6"
			fill="none"
			stroke="currentColor"
			stroke-width="1.3"></path>
	</svg>
	<span class="difficulty-words">
		<span aria-hidden="true">{showWord ? word : `${level}/${DIFFICULTY_SCALE}`}</span>
		<span class="sr-only">moeilijkheid {level} van {DIFFICULTY_SCALE}, {word}</span>
	</span>
</span>
