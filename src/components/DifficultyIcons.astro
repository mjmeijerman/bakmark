---
interface Props {
	/** Filled whisks. */
	level: number;
	scale?: number;
}

const { level, scale = 5 } = Astro.props;
---

<span class="difficulty-icons" aria-hidden="true">
	{
		Array.from({ length: scale }, (_, index) => (
			<svg
				class:list={["difficulty-icon", index < level ? "is-on" : "is-off"]}
				viewBox="0 0 24 24"
				focusable="false"
			>
				{/* A balloon whisk: solid head with three wire slots cut out, so the
				    shape still reads when it is 1.3rem wide. */}
				<rect x="10.7" y="1" width="2.6" height="5" rx="1.3" />
				<path
					fill-rule="evenodd"
					d="M12 5.4c-4.3 0-7.6 3.7-7.6 8.3 0 4.7 3.3 7.9 7.6 7.9s7.6-3.2 7.6-7.9c0-4.6-3.3-8.3-7.6-8.3Zm-3.25 3.8h1.3v10.2h-1.3zm2.6 0h1.3v10.2h-1.3zm2.6 0h1.3v10.2h-1.3z"
				/>
			</svg>
		))
	}
</span>
