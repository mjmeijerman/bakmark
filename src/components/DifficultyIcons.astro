---
interface Props {
	/** Filled spoons. */
	level: number;
	scale?: number;
}

const { level, scale = 5 } = Astro.props;
---

<span class="difficulty-icons" aria-hidden="true">
	{
		Array.from({ length: scale }, (_, index) => (
			<svg
				class:list={["difficulty-icon", index < level ? "is-on" : "is-off"]}
				viewBox="0 0 24 24"
				focusable="false"
			>
				{/* A mixing bowl. Tried at this size: chef's hat (reads as a
				    mushroom), whisk (reads as two letters), rolling pin (reads as a
				    dash), spoon (reads as a lollipop). A semicircle with a rim
				    survives being drawn 1.3rem wide. */}
				<path d="M3.2 10.4h17.6a8.8 8.8 0 0 1-17.6 0Z" />
				<rect x="2.2" y="7.6" width="19.6" height="2.8" rx="1.4" />
			</svg>
		))
	}
</span>
