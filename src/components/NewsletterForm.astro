---
import { DEFAULT_LANG, isLang, t, type Lang } from "../lib/i18n";

interface Props {
	lang?: Lang;
	heading?: string;
}

const { lang: rawLang, heading } = Astro.props;
const lang: Lang = isLang(rawLang) ? rawLang : DEFAULT_LANG;
---

<form class="signup" method="post" action="" data-signup>
	<h2>{heading ?? t(lang, "newsletter.heading")}</h2>
	<label for="email">{t(lang, "newsletter.label")}</label>
	<div class="signup-row">
		<input
			id="email"
			name="email"
			type="email"
			autocomplete="email"
			inputmode="email"
			required
		/>
		<button type="submit" disabled>{t(lang, "newsletter.button")}</button>
	</div>
	<p class="form-note">
		{t(lang, "newsletter.note")}
	</p>
</form>
