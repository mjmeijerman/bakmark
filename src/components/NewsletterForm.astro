---
import { DEFAULT_LANG, isLang, t, type Lang } from "../lib/i18n";

interface Props {
	lang?: Lang;
	heading?: string;
}

const { lang: rawLang, heading } = Astro.props;
const lang: Lang = isLang(rawLang) ? rawLang : DEFAULT_LANG;

const messages = {
	ok: t(lang, "newsletter.success"),
	invalid: t(lang, "newsletter.invalid"),
	error: t(lang, "newsletter.error"),
};
---

<form
	class="signup"
	id="nieuwsbrief"
	method="post"
	action="/api/subscribe"
	data-signup
	data-lang={lang}
	data-ok={messages.ok}
	data-invalid={messages.invalid}
	data-error={messages.error}
>
	<h2>{heading ?? t(lang, "newsletter.heading")}</h2>
	<label for={`email-${lang}`}>{t(lang, "newsletter.label")}</label>
	<div class="signup-row">
		<input
			id={`email-${lang}`}
			name="email"
			type="email"
			autocomplete="email"
			inputmode="email"
			maxlength="254"
			required
		/>
		<input type="hidden" name="lang" value={lang} />
		<button type="submit">{t(lang, "newsletter.button")}</button>
	</div>
	<div class="hp" aria-hidden="true">
		<label for={`bedrijf-${lang}`}>Bedrijf</label>
		<input id={`bedrijf-${lang}`} name="bedrijf" type="text" tabindex="-1" autocomplete="off" />
	</div>
	<p class="form-status" data-signup-status role="status" aria-live="polite"></p>
	<p class="form-note">
		{t(lang, "newsletter.note")}
	</p>
</form>

<script>
	const forms = document.querySelectorAll<HTMLFormElement>("form[data-signup]");

	const say = (form: HTMLFormElement, message: string, state: "ok" | "error") => {
		const status = form.querySelector<HTMLElement>("[data-signup-status]");
		if (!status) return;
		status.textContent = message;
		status.dataset.state = state;
	};

	forms.forEach((form) => {
		const input = form.querySelector<HTMLInputElement>('input[name="email"]');
		const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
		if (!input) return;

		// How long the form has been on screen; the server rejects sub-1.5s submits.
		const shownAt = Date.now();

		form.addEventListener("submit", async (event) => {
			event.preventDefault();
			const email = input.value.trim();
			if (!email) return;

			button?.setAttribute("disabled", "");
			say(form, "", "ok");

			try {
				const response = await fetch(form.action, {
					method: "POST",
					headers: { "content-type": "application/json", accept: "application/json" },
					body: JSON.stringify({
						email,
						lang: form.dataset.lang,
						source: window.location.pathname,
						elapsed: Date.now() - shownAt,
					}),
				});
				const result = (await response.json().catch(() => null)) as
					| { ok: boolean; error?: string }
					| null;

				if (response.ok && result?.ok) {
					form.reset();
					say(form, form.dataset.ok ?? "", "ok");
				} else {
					say(
						form,
						result?.error === "invalid_email"
							? form.dataset.invalid ?? ""
							: form.dataset.error ?? "",
						"error",
					);
				}
			} catch {
				say(form, form.dataset.error ?? "", "error");
			} finally {
				button?.removeAttribute("disabled");
			}
		});
	});

	// No-JS submits land back here with ?nieuwsbrief=ok|fout.
	const outcome = new URLSearchParams(window.location.search).get("nieuwsbrief");
	if (outcome && forms[0]) {
		say(forms[0], outcome === "ok" ? forms[0].dataset.ok ?? "" : forms[0].dataset.error ?? "", outcome === "ok" ? "ok" : "error");
	}
</script>
