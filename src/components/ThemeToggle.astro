---
import { DEFAULT_LANG, isLang, type Lang } from "../lib/i18n";

interface Props {
	lang?: Lang;
}

const { lang: rawLang } = Astro.props;
const lang: Lang = isLang(rawLang) ? rawLang : DEFAULT_LANG;
const labels =
	lang === "en"
		? { toDark: "Switch to dark mode", toLight: "Switch to light mode", dark: "Dark mode", light: "Light mode" }
		: { toDark: "Schakel naar donkere modus", toLight: "Schakel naar lichte modus", dark: "Donkere modus", light: "Lichte modus" };
---

<button type="button" class="theme-toggle" data-theme-toggle>
	<svg
		class="theme-icon theme-icon-sun"
		viewBox="0 0 16 16"
		aria-hidden="true"
		focusable="false"
	>
		<circle cx="8" cy="8" r="3" fill="none" stroke="currentColor" stroke-width="1.5"
		></circle>
		<path
			d="M8 1v1.6M8 13.4V15M1 8h1.6M13.4 8H15M3.05 3.05l1.13 1.13M11.82 11.82l1.13 1.13M12.95 3.05l-1.13 1.13M4.18 11.82l-1.13 1.13"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linecap="round"></path>
	</svg>
	<svg
		class="theme-icon theme-icon-moon"
		viewBox="0 0 16 16"
		aria-hidden="true"
		focusable="false"
	>
		<path
			d="M13.5 9.7A5.9 5.9 0 0 1 6.3 2.5a6 6 0 1 0 7.2 7.2Z"
			fill="none"
			stroke="currentColor"
			stroke-width="1.5"
			stroke-linejoin="round"></path>
	</svg>
</button>

<script is:inline>
	(function () {
		var root = document.documentElement;
		var button = document.querySelector("[data-theme-toggle]");
		if (!button) return;

		var media = window.matchMedia("(prefers-color-scheme: dark)");

		function stored() {
			try {
				var value = localStorage.getItem("theme");
				return value === "light" || value === "dark" ? value : null;
			} catch (error) {
				return null;
			}
		}

		function current() {
			return root.dataset.theme || (media.matches ? "dark" : "light");
		}

		/* The icon shows the mode a click takes you to: moon in light, sun in dark. */
		function render() {
			var dark = current() === "dark";
			button.dataset.state = dark ? "dark" : "light";
			button.setAttribute("aria-label", dark ? labels.toLight : labels.toDark);
			button.setAttribute("title", dark ? labels.light : labels.dark);
		}

		button.addEventListener("click", function () {
			var next = current() === "dark" ? "light" : "dark";
			root.dataset.theme = next;
			try {
				localStorage.setItem("theme", next);
			} catch (error) {}
			render();
		});

		// If no choice was stored, follow live system changes.
		media.addEventListener("change", function () {
			if (!stored()) render();
		});

		render();
	})();
</script>
