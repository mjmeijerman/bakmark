---
import Layout from "../../../layouts/Layout.astro";
import { t } from "../../../lib/i18n";
import { deleteByUnsubscribeToken } from "../../../lib/list";

export const prerender = false;

// A valid, used or unknown token all get the same page: the click itself is
// the whole interaction, and a stranger learns nothing from the answer.
deleteByUnsubscribeToken(Astro.url.searchParams.get("token") ?? "");
const lang = "en" as const;
---

<Layout title={t(lang, "unsubscribe.title")} description={t(lang, "unsubscribe.body")} lang={lang}>
	<section class="hero">
		<h1>{t(lang, "unsubscribe.title")}</h1>
	</section>
	<section class="section">
		<p>{t(lang, "unsubscribe.body")}</p>
		<p><a href="/en">{t(lang, "nav.home")}</a></p>
	</section>
</Layout>
