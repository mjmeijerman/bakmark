---
import Layout from "../layouts/Layout.astro";
import PlaceholderImage from "../components/PlaceholderImage.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import RecipeCard from "../components/RecipeCard.astro";
---

<Layout
	title="Bakmark"
	description="Complete bakingvideo's in één take, zonder montage. Geen advertenties, geen e-maillijst-muur, geen cursus aan het eind."
>
	<section class="hero">
		<p class="kicker">De ongeknipte thuisbakker</p>
		<h1>Bakken zonder knippen.</h1>
		<p class="lead">
			Complete bakingvideo's in één take: geen montage, geen versnelling, geen
			stap overgeslagen.
		</p>
		<p class="hero-actions">
			<a class="button" href="/recepten/soezendeeg">Naar het eerste recept</a>
		</p>
	</section>

	<PlaceholderImage
		label="Close-up van het eindresultaat"
		caption="Hier komt het gebakken resultaat, close en scherp. Geen stockfoto, geen styling die je thuis niet haalt."
		ratio="16 / 10"
	/>

	<section class="section">
		<h2>Nieuwste</h2>
		<p class="section-lede">
			De video's en recepten komen hier te staan zodra ze er zijn.
		</p>
		<ul class="card-grid">
			<li>
				<RecipeCard
					href="/recepten/soezendeeg"
					title="Soezendeeg"
					description="Het eerste recept: soesjes die opbollen in de oven, met de lastige minuut erin."
					imageLabel="Soesjes, close-up"
					chips={["45 min", "12 stuks", "basis"]}
					concept
				/>
			</li>
		</ul>
	</section>

	<hr class="rule" />

	<section class="section">
		<h2>Wat je hier niet krijgt</h2>
		<ul>
			<li>Geen advertentienetwerk, geen sponsorblokken, geen pop-ups.</li>
			<li>Geen e-maillijst-muur voor een recept.</li>
			<li>Geen cookiebanner, omdat er niets te vragen is.</li>
			<li>Geen cursus, geen abonnement, geen "premium" recepten.</li>
		</ul>
		<p>
			Affiliate-links zijn er soms wel. Die staan altijd gemarkeerd en kosten
			jou niets extra.
		</p>
	</section>

	<NewsletterForm />
</Layout>
