---
import Layout from "../../layouts/Layout.astro";
import NewsletterForm from "../../components/NewsletterForm.astro";
import {
	DIFFICULTY_SCALE,
	allRecipes,
	formatMinutes,
	recipeChips,
	recipeRoutes,
	resolveRecipe,
	totalTime,
	usedIn,
	type Recipe,
} from "../../lib/recipes";

export function getStaticPaths() {
	return recipeRoutes().map(({ slug, recipe }) => ({
		params: { slug },
		props: { recipe, canonical: recipe.slug },
	}));
}

const { recipe, canonical } = Astro.props as { recipe: Recipe; canonical: string };
const { groups } = resolveRecipe(recipe);
const composed = groups.length > 1;
const chips = recipeChips(recipe);
const activeTime = totalTime({ root: recipe, groups });
const bakeGroups = groups.filter((group) => group.recipe.bake);
const direct = groups.filter((group) => group.depth === 1);
const usedBy = usedIn(recipe.slug);
const titles = new Map(allRecipes().map((r) => [r.slug, r.title]));
const factorLabel = (factor: number) =>
	factor !== 1 ? ` ×${String(Math.round(factor * 100) / 100).replace(".", ",")}` : "";
---

<Layout
	title={recipe.title}
	description={`${recipe.title}: ${recipe.result.value} ${recipe.result.unit}. ${recipe.subtitle}`}
>
	<article>
		<section class="hero">
			<p class="kicker no-print">
				{recipe.verified ? recipe.category : "Concept · nog niet geverifieerd"}
			</p>
			<h1>{recipe.title}</h1>
			<p class="recipe-result">{recipe.subtitle}</p>
			<ul class="chips recipe-meta no-print">
				{chips.map((chip) => <li><span class="chip">{chip}</span></li>)}
				<li><span class="chip">moeilijkheid {recipe.difficulty}/{DIFFICULTY_SCALE}</span></li>
				{!recipe.verified && <li><span class="chip chip-concept">Concept</span></li>}
			</ul>
			<p class="recipe-summary">
				<strong>{recipe.result.value} {recipe.result.unit}</strong>{recipe.result.note ? ` — ${recipe.result.note}` : ""}
			</p>
			<p class="print-only">
				{formatMinutes(activeTime)} actief · moeilijkheid {recipe.difficulty}/{DIFFICULTY_SCALE}
				{bakeGroups.length ? ` · ${bakeGroups[0].recipe.bake.temperature} °C` : ""}
			</p>
		</section>

		{!recipe.verified && (
			<p class="verified-note no-print">
				<strong>Nog niet geverifieerd.</strong> {recipe.verified_note}
			</p>
		)}

		<div
			class="placeholder-box recipe-video no-print"
			style="--ratio: 16 / 9"
			role="img"
			aria-label={`Placeholder: video van ${recipe.title.toLowerCase()} in één take`}
		>
			<span aria-hidden="true">Placeholder</span>
			<strong aria-hidden="true">Video: {recipe.title.toLowerCase()} in één take</strong>
		</div>

		<section class="section no-print">
			<h2>Waarom dit werkt</h2>
			<p>{recipe.context}</p>
			<ul class="chips">
				{recipe.tags.map((tag) => <li><span class="chip">{tag}</span></li>)}
			</ul>
		</section>

		{recipe.variants && Object.keys(recipe.variants).length ? (
			<section class="section no-print">
				<h2>Varianten</h2>
				<p class="section-lede">
					Dezelfde stappen, een andere samenstelling. Een recept dat dit
					basisrecept gebruikt, kiest de variant; pas je de stappen aan, dan
					verandert dat in alle varianten mee.
				</p>
				<dl class="variants">
					{Object.entries(recipe.variants).map(([key, variant]) => (
						<div>
							<dt>{variant.label}</dt>
							<dd>{variant.note}{key === "klassiek" ? " (standaard)" : ""}</dd>
						</div>
					))}
				</dl>
			</section>
		) : null}

		{composed && (
			<section class="section no-print">
				<h2>Opbouw</h2>
				<p class="section-lede">
					Dit recept bestaat uit basisrecepten. Elk onderdeel heeft een eigen
					pagina en een eigen video, en wijzigingen daar werken hier direct
					door.
				</p>
				<ul class="parts">
					{direct.map((group) => (
						<li>
							<a href={`/recepten/${group.recipe.slug}`}>{group.recipe.title}</a>
							<span class="muted">
								{group.recipe.result.value} {group.recipe.result.unit}{factorLabel(group.factor)}
							</span>
						</li>
					))}
				</ul>
			</section>
		)}

		{usedBy.length ? (
			<section class="section no-print">
				<h2>Gebruikt in</h2>
				<p class="section-lede">
					Deze pagina is de bron. Elk recept hieronder gebruikt dit
					basisrecept, dus een wijziging hier werkt daar direct door.
				</p>
				<ul class="parts">
					{usedBy.map(({ recipe: user, via }) => (
						<li>
							<a href={`/recepten/${user.slug}`}>{user.title}</a>
							<span class="muted">
								{user.result.value} {user.result.unit}
								{via ? `, via ${titles.get(via) ?? via}` : ""}
							</span>
						</li>
					))}
				</ul>
			</section>
		) : null}

		<section class="section">
			<h2>Ingrediënten</h2>
			{groups.map((group, groupIndex) => (
				<div class="ingredient-group">
					{composed && (
						<h3>
							{group.recipe.title}
							<span class="muted">
								{group.variantLabel ? `${group.variantLabel} ` : ""}{factorLabel(group.factor)}
							</span>
							{groupIndex > 0 || group.recipe.slug !== canonical ? (
								<a class="group-link no-print" href={`/recepten/${group.recipe.slug}`}>
									basisrecept
								</a>
							) : null}
						</h3>
					)}
					{group.recipe.components?.length ? (
						<p class="form-note">
							{group.recipe.ingredients.length
								? "Bovenop de basisrecepten hierboven, plus:"
								: "Alles uit de basisrecepten hierboven."}
						</p>
					) : null}
					{group.ingredients.length ? (
						<ul class="ingredients">
							{group.ingredients.map((i) => (
								<li>
									<div class="ingredient-name">
										{i.name}
										{i.note && (
											<details class="ingredient-info">
												<summary aria-label={`Meer over ${i.name}`}>
													<span aria-hidden="true">i</span>
												</summary>
												<div class="ingredient-info-panel">
													<p>{i.note}</p>
												</div>
											</details>
										)}
									</div>
									<span class="amount">{i.amount_display}</span>
								</li>
							))}
						</ul>
					) : null}
				</div>
			))}
			<p class="form-note no-print">
				Soms staat er bij gereedschap een affiliate-link. Die is gemarkeerd en
				kost jou niets extra.
			</p>
		</section>

		{bakeGroups.map((group) => (
			<section class="section">
				<h2>Bakken{composed ? ` — ${group.recipe.title.toLowerCase()}` : ""}</h2>
				<dl class="bake">
					<div><dt>Ovenstand</dt><dd>{group.recipe.bake.mode} · {group.recipe.bake.rack}</dd></div>
					<div><dt>Temperatuur</dt><dd>{group.recipe.bake.temperature} °C (hetelucht {group.recipe.bake.temperature_hetelucht} °C)</dd></div>
					<div><dt>Baktijd</dt><dd>{formatMinutes(group.recipe.bake.time.min)} – {formatMinutes(group.recipe.bake.time.max)}</dd></div>
					<div><dt>Klaar wanneer</dt><dd>{group.recipe.bake.done_when}</dd></div>
					<div><dt>Ovendeur</dt><dd>{group.recipe.bake.door}</dd></div>
					<div><dt>Nadrogen</dt><dd>{formatMinutes(group.recipe.bake.afterbake.duration)}, deur op een kier</dd></div>
				</dl>
				<p class="form-note no-print">{group.recipe.bake.time_note}</p>
			</section>
		))}

		<section class="section">
			<h2>Stappen</h2>
			{groups.map((group) => (
				<div class="step-group">
					{composed && (
						<h3>
							{group.recipe.title}
							{group.variantLabel ? <span class="muted"> — {group.variantLabel}</span> : null}
							<a class="group-link no-print" href={`/recepten/${group.recipe.slug}`}>
								eigen pagina
							</a>
						</h3>
					)}
					<ol class="steps">
						{group.steps.map((step, index) => (
							<li id={`${group.recipe.slug}-${step.id}`}>
								<span class="step-num" aria-hidden="true">{index + 1}</span>
								<p><strong>{step.title}</strong></p>
								<p>{step.text}</p>
								{step.why && <p class="step-why"><strong>Waarom:</strong> {step.why}</p>}
								{step.tips?.length ? (
									<ul class="step-tips">
										{step.tips.map((tip) => <li>{tip}</li>)}
									</ul>
								) : null}
							</li>
						))}
					</ol>
				</div>
			))}
			<p class="form-note no-print">
				Tijden en temperaturen zijn startwaarden. De definitieve versie komt uit
				de opname, met de echte tijden en de volgorde van de video.
			</p>
		</section>

		{recipe.mislukt?.length ? (
			<section class="section no-print">
				<h2>Als het mislukt</h2>
				<table class="mislukt">
					<thead>
						<tr><th>Symptoom</th><th>Oorzaak</th><th>Oplossing</th></tr>
					</thead>
					<tbody>
						{recipe.mislukt.map((m) => (
							<tr><td>{m.symptoom}</td><td>{m.oorzaak}</td><td>{m.fix}</td></tr>
						))}
					</tbody>
				</table>
			</section>
		) : null}

		{recipe.faq?.length ? (
			<section class="section no-print">
				<h2>Veelgestelde vragen</h2>
				<div class="faq">
					{recipe.faq.map((f) => (
						<details>
							<summary>{f.q}</summary>
							<p>{f.a}</p>
						</details>
					))}
				</div>
			</section>
		) : null}

		<section class="section no-print">
			<h2>Printen</h2>
			<p>
				De printversie houdt alleen de ingrediënten en de stappen over, zonder
				uitleg en zonder foto's. Twee kantjes op het aanrecht, niet meer.
			</p>
			<p>
				<button class="button" type="button" data-print>Print dit recept</button>
			</p>
		</section>

		<section class="callout no-print">
			<h2>Een fooi?</h2>
			<p>
				De recepten en video's zijn gratis. Wie er iets aan heeft, kan een
				fooi achterlaten. Wie dat niet doet, merkt daar niets van.
			</p>
			<ul class="tips">
				<li><span class="tip-amount">€3</span></li>
				<li><span class="tip-amount">€7</span></li>
				<li><span class="tip-amount">€15</span></li>
				<li><span class="tip-amount">€25</span></li>
				<li><span class="tip-amount">Eigen bedrag</span></li>
			</ul>
			<p class="form-note">Placeholder: de betaallink komt er bij de eerste video.</p>
		</section>
	</article>

	<NewsletterForm heading="Nieuwsbrief" />
</Layout>

<script>
	// One ingredient note open at a time, and a click or Escape anywhere else
	// closes it. <details> does the toggling itself; this only adds dismissal,
	// so the notes still work with JavaScript off.
	const notes = document.querySelectorAll<HTMLDetailsElement>("details.ingredient-info");

	const closeNotes = (keep?: Element) => {
		notes.forEach((note) => {
			if (note !== keep) note.open = false;
		});
	};

	document.addEventListener("click", (event) => {
		const target = event.target as Element | null;
		closeNotes(target?.closest("details.ingredient-info") ?? undefined);
	});

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape") closeNotes();
	});

	// Print view is this page with the explanations hidden by @media print.
	// One button, no second artifact that can drift from the data.
	document.querySelector("[data-print]")?.addEventListener("click", () => window.print());
</script>
