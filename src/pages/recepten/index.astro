---
import Layout from "../../layouts/Layout.astro";
import RecipeCard from "../../components/RecipeCard.astro";
import {
	CATEGORIES,
	DIFFICULTY_SCALE,
	TIME_BUCKETS,
	allRecipes,
	recipeChips,
	type Recipe,
} from "../../lib/recipes";

const recipes = allRecipes();

const minutes = (recipe: Recipe) => Math.round(recipe.time.total / 60);

/** Count per facet value; values with one recipe stay visible but disabled (D20). */
const count = (predicate: (recipe: Recipe) => boolean) => recipes.filter(predicate).length;

const categoryOptions = CATEGORIES.map((category) => ({
	id: category.id,
	label: category.label,
	total: count((recipe) => recipe.category === category.id),
})).filter((option) => option.total > 0);

const roleOptions = [
	{ id: "gerecht", label: "gerecht", total: count((recipe) => recipe.role === "gerecht") },
	{ id: "basis", label: "basisrecept", total: count((recipe) => recipe.role === "basis") },
];

const difficultyOptions = Array.from({ length: DIFFICULTY_SCALE }, (_, index) => index + 1).map(
	(level) => ({
		id: String(level),
		label: `${level}/${DIFFICULTY_SCALE}`,
		total: count((recipe) => recipe.difficulty === level),
	}),
);

const timeOptions = TIME_BUCKETS.map((bucket) => ({
	id: bucket.id,
	label: bucket.label,
	total: count((recipe) => {
		const total = recipe.time.total;
		return total >= bucket.min && total < bucket.max;
	}),
}));
---

<Layout
	title="Alle recepten"
	description="Alle recepten op Bakmark, met video's zonder knippen. Filter op categorie, rol, moeilijkheid en tijd."
>
	<section class="hero">
		<p class="kicker">Recepten</p>
		<h1>Alle recepten</h1>
		<p class="lead">
			Basisrecepten en de gerechten die eruit volgen. Elk onderdeel heeft een
			eigen pagina en een eigen video.
		</p>
	</section>

	<section class="section">
		<h2>Filteren</h2>
		<form class="filters" data-filters aria-describedby="filter-note">
			<fieldset>
				<legend>Categorie</legend>
				<div class="filter-row">
					{categoryOptions.map((option) => (
						<button
							type="button"
							class="filter-chip"
							data-facet="category"
							data-value={option.id}
							aria-pressed="false"
							disabled={option.total < 2}
							title={option.total < 2 ? "Komt één recept in voor" : undefined}
						>
							{option.label}<span class="filter-count">{option.total}</span>
						</button>
					))}
				</div>
			</fieldset>

			<fieldset>
				<legend>Rol</legend>
				<div class="filter-row">
					{roleOptions.map((option) => (
						<button
							type="button"
							class="filter-chip"
							data-facet="role"
							data-value={option.id}
							aria-pressed="false"
							disabled={option.total < 1}
						>
							{option.label}<span class="filter-count">{option.total}</span>
						</button>
					))}
				</div>
			</fieldset>

			<fieldset>
				<legend>Moeilijkheid</legend>
				<div class="filter-row">
					{difficultyOptions.map((option) => (
						<button
							type="button"
							class="filter-chip"
							data-facet="difficulty"
							data-value={option.id}
							aria-pressed="false"
						>
							{option.label}<span class="filter-count">{option.total}</span>
						</button>
					))}
				</div>
			</fieldset>

			<fieldset>
				<legend>Tijd (totaal)</legend>
				<div class="filter-row">
					{timeOptions.map((option) => (
						<button
							type="button"
							class="filter-chip"
							data-facet="time"
							data-value={option.id}
							aria-pressed="false"
						>
							{option.label}<span class="filter-count">{option.total}</span>
						</button>
					))}
				</div>
			</fieldset>

			<p class="filter-reset">
				<button type="button" class="filter-reset-button" data-reset hidden>
					Filters wissen
				</button>
				<span class="form-note" id="filter-note" data-count>
					{recipes.length} recepten
				</span>
			</p>
			<p class="form-note">
				Grijze filters hebben nog te weinig recepten om te kiezen. Ze gaan vanzelf
				aan zodra er een tweede recept in valt.
			</p>
		</form>
	</section>

	<section class="section">
		<h2>Alles</h2>
		<ul class="card-grid" data-results>
			{recipes.map((recipe) => (
				<li
					data-category={recipe.category}
					data-role={recipe.role}
					data-difficulty={recipe.difficulty}
					data-minutes={minutes(recipe)}
				>
					<RecipeCard
						href={`/recepten/${recipe.slug}`}
						title={recipe.title}
						description={recipe.subtitle}
						imageLabel={`${recipe.title.toLowerCase()}, close-up`}
						chips={recipeChips(recipe)}
						concept={!recipe.verified}
					/>
				</li>
			))}
		</ul>
		<p class="form-note" data-empty hidden>
			Geen recepten met deze combinatie. Wis een filter om breder te zoeken.
		</p>
	</section>
</Layout>

<script>
	// Filters are OR within a facet and AND across facets. Everything is
	// rendered server-side, so with JavaScript off the full list still shows.
	const form = document.querySelector<HTMLFormElement>("[data-filters]");
	const results = document.querySelector<HTMLElement>("[data-results]");
	const empty = document.querySelector<HTMLElement>("[data-empty]");
	const counter = document.querySelector<HTMLElement>("[data-count]");
	const reset = document.querySelector<HTMLButtonElement>("[data-reset]");

	if (form && results && empty && counter && reset) {
		const chips = Array.from(form.querySelectorAll<HTMLButtonElement>("[data-facet]"));
		const cards = Array.from(results.children) as HTMLElement[];
		const selected = new Map<string, Set<string>>();

		const buckets: Record<string, [number, number]> = {
			kort: [0, 1800],
			middel: [1800, 3600],
			lang: [3600, Number.POSITIVE_INFINITY],
		};

		const matches = (card: HTMLElement): boolean => {
			const seconds = Number(card.dataset.minutes ?? 0) * 60;
			return Array.from(selected.entries()).every(([facet, values]) => {
				if (values.size === 0) return true;
				if (facet === "category") return values.has(card.dataset.category ?? "");
				if (facet === "role") return values.has(card.dataset.role ?? "");
				if (facet === "difficulty") return values.has(card.dataset.difficulty ?? "");
				if (facet === "time") {
					return Array.from(values).some((id) => {
						const range = buckets[id];
						return range ? seconds >= range[0] && seconds < range[1] : true;
					});
				}
				return true;
			});
		};

		const apply = () => {
			let visible = 0;
			for (const card of cards) {
				const show = matches(card);
				card.hidden = !show;
				if (show) visible += 1;
			}
			counter.textContent =
				visible === cards.length
					? `${cards.length} recepten`
					: `${visible} van ${cards.length} recepten`;
			empty.hidden = visible > 0;
			reset.hidden = !Array.from(selected.values()).some((values) => values.size > 0);
		};

		for (const chip of chips) {
			chip.addEventListener("click", () => {
				const facet = chip.dataset.facet as string;
				const value = chip.dataset.value as string;
				const values = selected.get(facet) ?? new Set<string>();
				if (values.has(value)) values.delete(value);
				else values.add(value);
				selected.set(facet, values);
				chip.setAttribute("aria-pressed", String(values.has(value)));
				apply();
			});
		}

		reset.addEventListener("click", () => {
			selected.clear();
			for (const chip of chips) chip.setAttribute("aria-pressed", "false");
			apply();
		});

		apply();
	}
</script>
