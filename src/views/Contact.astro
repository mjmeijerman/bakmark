---
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../lib/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const legal = "legal@bakmark.nl";

const copy = {
	nl: {
		title: "Contact en privacy",
		description:
			"Bakvragen horen in de comments op YouTube. Voor privacy en juridische vragen is er één e-mailadres.",
		kicker: "Contact",
		h1: "Contact en privacy",
		lead: "Gewoon Nederlands, zonder juridische omwegen. En met één duidelijk adres.",
		baking: {
			h: "Bakvragen",
			p: "Bakvragen horen in de comments onder de video op YouTube. Daar leest iedereen mee en heeft de volgende met hetzelfde probleem er ook iets aan.",
		},
		legalQuestions: {
			h: "Privacy en juridische vragen",
			before: "Voor privacy, auteursrecht en andere juridische vragen:",
			after: "Dat is het enige e-mailadres van Bakmark.",
		},
		privacy: {
			h: "Privacy",
			intro:
				"Deze site is van Mark Meijerman. Je leest mee zonder account, dus er zijn heel weinig gegevens.",
			stored: {
				h: "Wat er wordt opgeslagen",
				items: [
					{
						strong: "Je themakeuze",
						text: "(licht of donker) staat in je eigen browser. Die gaat niet naar een server en je kunt hem wissen door de sitegegevens te verwijderen.",
					},
					{
						strong: "Je e-mailadres",
						text: ", alleen als je je aanmeldt voor het bericht bij een nieuwe video. Dat staat op de server van Bakmark zelf, niet bij een maildienst. Elke mail heeft een afmeldlink.",
					},
					{
						strong: "Bezoekcijfers",
						text: " worden zonder cookies en zonder persoonsgegevens geteld, als die telling er eenmaal is.",
					},
				],
			},
			kept: {
				h: "Waar je gegevens blijven",
				items: [
					"Je gegevens blijven bij Bakmark, op een server in de EU.",
					"Je krijgt alleen de mail die je zelf hebt aangevraagd, met een afmeldlink.",
					"Er worden geen advertentieprofielen van je gemaakt en niets wordt doorverkocht.",
					"Verder komt er niets van derden bij.",
				],
			},
			rights: {
				h: "Je rechten",
				before:
					"Je kunt opvragen welke gegevens er van je zijn, ze laten corrigeren of laten verwijderen. Mail daarvoor naar",
				after:
					"Ben je het niet eens met de afhandeling, dan kun je een klacht indienen bij de Autoriteit Persoonsgegevens.",
			},
		},
	},
	en: {
		title: "Contact and privacy",
		description:
			"Baking questions belong in the comments on YouTube. For privacy and legal questions there is one email address.",
		kicker: "Contact",
		h1: "Contact and privacy",
		lead: "Plain language, no legal detours. And one clear address.",
		baking: {
			h: "Baking questions",
			p: "Baking questions belong in the comments under the video on YouTube. Everyone reads along there, and the next person with the same problem benefits too.",
		},
		legalQuestions: {
			h: "Privacy and legal questions",
			before: "For privacy, copyright and other legal questions:",
			after: "That is the only email address Bakmark has.",
		},
		privacy: {
			h: "Privacy",
			intro:
				"This site belongs to Mark Meijerman. You read along without an account, so there is very little data.",
			stored: {
				h: "What is stored",
				items: [
					{
						strong: "Your theme choice",
						text: " (light or dark) lives in your own browser. It never goes to a server, and you can clear it by deleting the site data.",
					},
					{
						strong: "Your email address",
						text: ", only if you sign up for the message when a new video is out. It sits on Bakmark's own server, not at a mailing service. Every email has an unsubscribe link.",
					},
					{
						strong: "Visit counts",
						text: " are tallied without cookies and without personal data, once that counting exists.",
					},
				],
			},
			kept: {
				h: "Where your data stays",
				items: [
					"Your data stays with Bakmark, on a server in the EU.",
					"You only get the email you asked for, with an unsubscribe link.",
					"No advertising profiles are built from you and nothing is resold.",
					"Nothing from third parties is added.",
				],
			},
			rights: {
				h: "Your rights",
				before:
					"You can ask which of your data is held, have it corrected or deleted. Email",
				after:
					"If you disagree with how it is handled, you can complain to the Dutch Data Protection Authority (Autoriteit Persoonsgegevens).",
			},
		},
	},
}[lang];
---

<Layout title={copy.title} description={copy.description} lang={lang}>
	<section class="hero">
		<p class="kicker">{copy.kicker}</p>
		<h1>{copy.h1}</h1>
		<p class="lead">{copy.lead}</p>
	</section>

	<section class="section">
		<h2>{copy.baking.h}</h2>
		<p>{copy.baking.p}</p>
	</section>

	<section class="section">
		<h2>{copy.legalQuestions.h}</h2>
		<p>
			{copy.legalQuestions.before}{" "}
			<a href={`mailto:${legal}`}>{legal}</a>. {copy.legalQuestions.after}
		</p>
	</section>

	<hr class="rule" />

	<section class="section" id="privacy">
		<h2>{copy.privacy.h}</h2>
		<p>{copy.privacy.intro}</p>

		<h3>{copy.privacy.stored.h}</h3>
		<ul>
			{
				copy.privacy.stored.items.map((item) => (
					<li>
						<strong>{item.strong}</strong>
						{item.text}
					</li>
				))
			}
		</ul>

		<h3>{copy.privacy.kept.h}</h3>
		<ul>
			{copy.privacy.kept.items.map((item) => <li>{item}</li>)}
		</ul>

		<h3>{copy.privacy.rights.h}</h3>
		<p>
			{copy.privacy.rights.before}{" "}
			<a href={`mailto:${legal}`}>{legal}</a>. {copy.privacy.rights.after}
		</p>
	</section>
</Layout>
