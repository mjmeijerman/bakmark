---
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../lib/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const copy = {
	nl: {
		title: "Hoe het werkt",
		description:
			"Eén take, hoofdstukken als kookwekker, een printversie en een bakmodus. Gratis, met een fooi als je wilt.",
		kicker: "Hoe het werkt",
		h1: "Eén take, en dan heb je het hele proces gezien.",
		lead: "Zo gebruik je de video's, het recept en de printversie in je eigen keuken.",
		sections: [
			{
				h: "Eén take, in echte tijd",
				p: [
					"Elke video is in één keer opgenomen, in de tijd die het kost. De tijd op het scherm loopt gelijk met de jouwe, en je ziet de handen hetzelfde werk doen als jij straks doet.",
				],
			},
			{
				h: "Hoofdstukken als kookwekker",
				p: [
					"Elke fase heeft een eigen hoofdstuk: kneden, rusten, vormen, bakken. Je springt naar de fase die je nodig hebt, zet hem aan en loopt terug naar je aanrecht. De video werkt als echt tijdgenoot, niet alleen als instructie.",
				],
			},
			{
				h: "Printversie",
				p: [
					"Bij elk recept staat een printfunctie: met of zonder foto's, met de juiste paginering. Het vel gaat mee naar het aanrecht, waar je handen vet zijn en je telefoon niet thuishoort.",
				],
			},
			{
				h: "Gratis, met een fooi als je wilt",
				p: [
					"Alles is gratis en blijft gratis, zonder account. Wie het wat waard vindt, kan een fooi geven. Wie dat niet doet, merkt daar niets van.",
				],
			},
		],
	},
	en: {
		title: "How it works",
		description:
			"One take, chapters as a kitchen timer, a print version and a bake mode. Free, with a tip if you like.",
		kicker: "How it works",
		h1: "One take, and you have seen the whole process.",
		lead: "This is how you use the videos, the recipe and the print version in your own kitchen.",
		sections: [
			{
				h: "One take, in real time",
				p: [
					"Every video is recorded in one go, in the time it takes. The clock on screen runs level with yours, and you see hands doing the same work yours will do.",
				],
			},
			{
				h: "Chapters as a kitchen timer",
				p: [
					"Every stage has its own chapter: kneading, resting, shaping, baking. Jump to the stage you need, start it, and walk back to your worktop. The video keeps time with you, not just gives instructions.",
				],
			},
			{
				h: "Print version",
				p: [
					"Every recipe has a print function: with or without photos, paginated properly. The sheet goes to the worktop, where your hands are greasy and your phone does not belong.",
				],
			},
			{
				h: "Free, with a tip if you like",
				p: [
					"Everything is free and stays free, without an account. If you find it worth something, you can leave a tip. If you don't, you notice nothing of it.",
				],
			},
		],
	},
}[lang];
---

<Layout title={copy.title} description={copy.description} lang={lang}>
	<section class="hero">
		<p class="kicker">{copy.kicker}</p>
		<h1>{copy.h1}</h1>
		<p class="lead">{copy.lead}</p>
	</section>

	{
		copy.sections.map((section) => (
			<section class="section">
				<h2>{section.h}</h2>
				{section.p.map((paragraph) => (
					<p>{paragraph}</p>
				))}
			</section>
		))
	}
</Layout>
