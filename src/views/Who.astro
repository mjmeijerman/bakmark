---
import Layout from "../layouts/Layout.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import type { Lang } from "../lib/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const copy = {
	nl: {
		title: "Over mij",
		description: "Wie Bakmark maakt, en waarom.",
		h1: "Over mij",
		photoAlt: "Mark Meijerman in de keuken waar de video's worden opgenomen.",
		heading: "Waar dit begon",
		paragraphs: [
			"Ik ben Mark. Al van kinds af aan vind ik het leuk om van een paar ingrediënten iets lekkers te maken — mijn eerste chocoladecake maakte ik al vroeg. Later ging ik steeds meer experimenteren met taart, cake en gebak.",
			"Het smaakte altijd goed, maar nooit zoals bij de bakker. Ik zocht uit waar dat aan lag, en de conclusie was simpel: goede bakkersrecepten zijn lastig te vinden. Voor één product bekeek ik al snel meerdere filmpjes en recepten. Het resultaat was goed, maar ik schreef niets op — dus begon ik de volgende keer aan precies dezelfde zoektocht.",
			"Dat moest anders. Ik wilde één overzichtelijke catalogus met de recepten die ik zelf heb uitgezocht en gemaakt, met duidelijke filmpjes als ondersteuning. In eerste instantie bouwde ik deze site voor mezelf. Dat anderen er nu ook wat aan hebben, is mooi meegenomen.",
		],
	},
	en: {
		title: "About me",
		description: "Who makes Bakmark, and why.",
		h1: "About me",
		photoAlt: "Mark Meijerman in the kitchen where the videos are recorded.",
		heading: "Where this started",
		paragraphs: [
			"I am Mark. Ever since I was a child I have loved turning a few ingredients into something tasty — I made my first chocolate cake early on. Later I started experimenting more and more with tarts, cakes and pastries.",
			"It always tasted good, but never quite like the bakery's. I set out to find out why, and the conclusion was simple: good bakery recipes are hard to find. For a single product I would soon be watching several videos and reading several recipes. The result was good, but I wrote nothing down — so the next time I started the exact same search.",
			"That had to change. I wanted one clear catalogue of the recipes I had picked out and baked myself, with clear videos supporting them. At first I built this site for myself. That others get something out of it too is a nice bonus.",
		],
	},
}[lang];
---

<Layout title={copy.title} description={copy.description} lang={lang}>
	<section class="hero hero-tight">
		<h1>{copy.h1}</h1>
	</section>

	<figure class="portrait">
		<img
			src="/portret-mark.jpg"
			alt={copy.photoAlt}
			width="1464"
			height="1600"
			loading="lazy"
			decoding="async"
		/>
	</figure>

	<section class="section">
		<h2>{copy.heading}</h2>
		{
			copy.paragraphs.map((paragraph) => (
				<p>{paragraph}</p>
			))
		}
	</section>

	<hr class="rule" />

	<NewsletterForm lang={lang} />
</Layout>
