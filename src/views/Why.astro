---
import Layout from "../layouts/Layout.astro";
import type { Lang } from "../lib/i18n";

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;

const copy = {
	nl: {
		title: "Waarom",
		description:
			"Elke stap blijft erin, in de tijd die het kost. Eerlijk over affiliate-links en over wat een fooi doet.",
		kicker: "Waarom",
		h1: "Elke stap blijft erin.",
		lead: "Bakken is timing en geduld. Dus loopt de video mee in echte tijd: het wachten, het roeren, het rijzen.",
		sections: [
			{
				h: "Alles in één take",
				p: [
					"Het wachten, het roeren, het rijzen: het zit er allemaal in, in de tijd die het echt kost. Wat je ziet is wat er in de keuken gebeurt, in dezelfde tijd als bij jou thuis.",
				],
			},
			{
				h: "Mijn eigen keuzes",
				p: [
					"Bakmark is van mij. Ik kies zelf welke producten en merken er in een recept staan, en niemand koopt een plek. Sluit je het tabblad, dan ben je weg en kijkt er niets mee.",
				],
			},
			{
				h: "Wel eerlijke affiliate-links",
				p: [
					"Soms link ik naar gereedschap of ingrediënten dat ik zelf gebruik. Zo'n link is gemarkeerd als affiliate-link. Koop je via die link, dan krijg ik een klein bedrag van de winkel; voor jou wordt het niet duurder.",
					"Een product komt in een recept omdat het werkt. Staat er geen link, dan vond ik het de moeite niet waard.",
				],
			},
			{
				h: "Vrij te lezen",
				p: [
					"Recepten zijn vrij te lezen, te printen en te bewaren, zonder eerst een adres in te vullen. De nieuwsbrief is er voor wie een bericht wil bij een nieuwe video.",
				],
			},
			{
				h: "Gratis, met een fooi als je wilt",
				p: [
					"De recepten en video's zijn gratis, zonder account. Wie het wat waard vindt, legt een fooi neer; wie dat niet doet, kijkt net zo makkelijk verder.",
					"Komt er ooit iets bij, zoals een cursus, dan staat dat los van wat hier staat. De recepten en video's blijven vrij.",
				],
			},
		],
	},
	en: {
		title: "Why",
		description:
			"Every step stays in, in the time it takes. Honest about affiliate links and about what a tip does.",
		kicker: "Why",
		h1: "Every step stays in.",
		lead: "Baking is timing and patience. So the video runs along in real time: the waiting, the stirring, the proving.",
		sections: [
			{
				h: "All in one take",
				p: [
					"The waiting, the stirring, the proving: it is all there, in the time it really takes. What you see is what happens in the kitchen, in the same time as in yours.",
				],
			},
			{
				h: "My own choices",
				p: [
					"Bakmark is mine. I choose which products and brands end up in a recipe, and nobody buys a place. Close the tab and you are gone; nothing follows you.",
				],
			},
			{
				h: "Honest affiliate links, though",
				p: [
					"Sometimes I link to tools or ingredients I use myself. Such a link is marked as an affiliate link. Buy through it and I receive a small amount from the shop; it never costs you more.",
					"A product is in a recipe because it works. If there is no link, I did not think it was worth one.",
				],
			},
			{
				h: "Free to read",
				p: [
					"Recipes are free to read, print and keep, without filling in an address first. The newsletter is there for anyone who wants a message when a new video is out.",
				],
			},
			{
				h: "Free, with a tip if you like",
				p: [
					"The recipes and videos are free, without an account. If you find it worth something, leave a tip; if you don't, you read on just as easily.",
					"If something is ever added, such as a course, it stands apart from what is here. The recipes and videos stay free.",
				],
			},
		],
	},
}[lang];
---

<Layout title={copy.title} description={copy.description} lang={lang}>
	<section class="hero">
		<p class="kicker">{copy.kicker}</p>
		<h1>{copy.h1}</h1>
		<p class="lead">{copy.lead}</p>
	</section>

	{
		copy.sections.map((section) => (
			<section class="section">
				<h2>{section.h}</h2>
				{section.p.map((paragraph) => (
					<p>{paragraph}</p>
				))}
			</section>
		))
	}
</Layout>
