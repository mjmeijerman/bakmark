{
  "extends": "astro/tsconfigs/strict",
  // src/lib/videos.ts is also loaded by a plain node script (scripts/newsletter.mjs),
  // which resolves imports as ESM and needs the real filename.
  "compilerOptions": { "allowImportingTsExtensions": true },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
